{
  "name": "@mcoder/tui",
  "version": "0.1.0",
  "description": "mcoder TUI client",
  "type": "module",
  "bin": {
    "mcoder-tui": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.tsx",
    "test": "node --import tsx test-todo-summary.mjs && node --import tsx test-ask.mjs && node --import tsx test-session-snapshot.ts && node --import tsx test-resume-state.ts && node --import tsx test-phase5c-resume.ts && node --import tsx test-phase5c-hydrate.ts",
    "test:ask": "node --import tsx test-ask.mjs",
    "test:todo": "node --import tsx test-todo-summary.mjs",
    "test:snapshot": "node --import tsx test-session-snapshot.ts",
    "test:resume": "node --import tsx test-resume-state.ts",
    "test:phase5c-resume": "node --import tsx test-phase5c-resume.ts",
    "test:phase5c-hydrate": "node --import tsx test-phase5c-hydrate.ts"
  },
  "dependencies": {
    "ink": "^5.0.0",
    "ink-picture": "^2.1.0",
    "ink-select-input": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "qrcode-terminal": "^0.12.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ws": "^8.18.0",
    "yargs-parser": "^21.1.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^18.2.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  }
}
